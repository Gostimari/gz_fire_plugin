<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_fire_plugin</name>
  <version>1.0.0</version>
  <description>
    Gazebo Harmonic plugin for simulating fire and flame effects.
    Attach to any robot link to get particle-based fire visuals
    and heat-cone ray scanning.
  </description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-sim8</depend>
  <depend>gz-plugin2</depend>
  <depend>gz-transport13</depend>
  <depend>gz-msgs10</depend>
  <depend>gz-math7</depend>
  <depend>sdformat14</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
