<?xml version="1.0"?>
<!--
  fire_nozzle.urdf
  ─────────────────
  Standalone fire-nozzle model.
  Attach this to your robot's end-effector via a fixed joint,
  or use fire_nozzle.urdf.xacro for parameterised integration.
-->
<robot name="fire_nozzle">

  <!-- ── Nozzle body ──────────────────────────────────────── -->
  <link name="fire_nozzle_base_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.25"/>
      </geometry>
      <material name="dark_metal">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.25"/>
      </geometry>
    </collision>
  </link>

  <!-- ── Flame tip link (plugin attaches here) ───────────── -->
  <!-- Offset 0.15 m from base, +Z = flame direction           -->
  <link name="fire_source_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="tip">
        <color rgba="1.0 0.6 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_tip" type="fixed">
    <parent link="fire_nozzle_base_link"/>
    <child  link="fire_source_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ══ Gazebo FirePlugin ══ -->
  <gazebo>
    <plugin filename="libFirePlugin.so"
            name="gz::sim::systems::FirePlugin">
      <fire_link>fire_source_link</fire_link>
      <cone_half_angle>20.0</cone_half_angle>
      <cone_max_range>2.0</cone_max_range>
      <fire_color>1.0 0.4 0.0 1.0</fire_color>
      <particle_rate>200</particle_rate>
      <intensity>1.0</intensity>
      <num_rays>20</num_rays>
      <fire_topic>/fire/trigger</fire_topic>
    </plugin>
  </gazebo>

</robot>
